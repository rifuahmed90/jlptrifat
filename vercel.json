{
  "version": 2,
  "builds": [
    {
      "type": "static",
      "src": "index.html",
      "config": {
        "include": [
          "**/*.js",
          "**/*.css",
          "**/*.json",
          "**/*.{png,jpg,svg,png}",
          "icons/**",
          "sw.js",
          "data/**/*.json"
        ]
      },
      "diskSizeInMB": 1024
    }
  ],
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/data/(n5|n4|n3|n2|n1|radicals|grammar)\\.json",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/(js|css|icons)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}