{
    "version": 2,
    "builds": [
      {
        "type": "static",
        "src": "index.html",
        "config": {
          "include": ["**/*.js", "**/*.css", "**/*.json", "**/*.{png,jpg,svg,png}", "icons/**", "sw.js"]
        },
        "diskSizeInMB": 512
      }
    ],
    "routes": [
      {
        "src": "/sw.js",
        "headers": {
          "Cache-Control": "public, max-age=0, must-revalidate",
          "Service-Worker-Allowed": "/"
        }
      },
      {
        "src": "/bundle.js",
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      },
      {
        "src": "/(js|css|icons)/(.*)",
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ],
    "rewrites": [
      { "source": "/(.*)", "destination": "/index.html" }
    ]
  }